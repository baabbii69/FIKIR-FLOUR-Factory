{
  "name": "fikir-flour",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run snapshot && npm run sitemap && tsc -b && vite build",
    "preview": "vite preview",
    "snapshot": "tsx scripts/snapshot.ts",
    "seed": "tsx scripts/seed.ts",
    "cms:audit": "tsx scripts/audit.ts && tsx scripts/checkKeys.ts",
    "deploy:build": "npm run build && npm run prerender && tsx scripts/pruneMedia.ts --apply && tsx scripts/verifyWiring.ts",
    "verify": "tsx scripts/verifyWiring.ts",
    "check:cors": "tsx scripts/checkCors.ts",
    "sitemap": "tsx scripts/sitemap.ts",
    "prerender": "tsx scripts/prerender.ts",
    "catalogue": "tsx scripts/catalogueImages.ts"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.5",
    "@fontsource/dm-mono": "^5.2.5",
    "@fontsource/dm-sans": "^5.2.5",
    "@fontsource/noto-sans-ethiopic": "^5.2.7",
    "@fontsource/noto-serif-ethiopic": "^5.2.9",
    "@phosphor-icons/react": "^2.1.7",
    "@sanity/client": "^7.26.0",
    "@sanity/image-url": "^2.1.1",
    "gsap": "^3.12.7",
    "lenis": "^1.1.20",
    "motion": "^12.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer-core": "^25.6.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
