# ---------------------------------------------------------------------------
# Everything below is for a deploy with a serverless backend (e.g. Vercel).
# The live site is a STATIC build on Plesk, where none of it is set: leads go
# straight to Web3Forms and reach fikirfoods8@gmail.com.
#
# Leave VITE_LEAD_ENDPOINT empty unless /api/lead genuinely exists. Pointing it
# at a host that answers with the SPA fallback is worse than leaving it unset.
# ---------------------------------------------------------------------------
VITE_LEAD_ENDPOINT=

# Required lead delivery channel (only when VITE_LEAD_ENDPOINT is set)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# Optional but strongly recommended Cloudflare Turnstile protection.
# The VITE_ value is public and must be configured at build time.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional comma-separated production domains, e.g. https://fikirfoods.et,https://www.fikirfoods.et
# The current Vercel request host is always accepted automatically.
ALLOWED_ORIGINS=

# Optional sanitized operational alert webhook for delivery/Turnstile outages.
LEAD_ALERT_WEBHOOK_URL=
